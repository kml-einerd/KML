# ============================================
# ETL - Sistema de Análise de Fundos Top 100
# ============================================

# IMPORTANTE: Copie este arquivo para .env e preencha com suas credenciais

# ==========================================
# SUPABASE
# ==========================================
# Obtenha em: https://app.supabase.com/project/_/settings/api

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-service-role-key-aqui

# ==========================================
# CONFIGURAÇÕES
# ==========================================

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Tamanho do batch para upload (quantidade de linhas por lote)
BATCH_SIZE=1000

# Processar apenas Top 100 grupos (true/false)
TOP100_MODE=true

# Quantidade de grupos no ranking (padrão: 100)
TOP_N_GROUPS=100
